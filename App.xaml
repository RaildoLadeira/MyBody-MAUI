<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyBody.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Paleta de Cores do App -->
            <Color x:Key="PrimaryColor">#512BD4</Color>
            <Color x:Key="PrimaryDark">#3C1EB2</Color>
            <Color x:Key="AccentGreen">#2E7D32</Color>
            <Color x:Key="AccentOrange">#E65100</Color>

            <!-- Cores para Modo Claro (Light Mode) -->
            <Color x:Key="LightBackground">#F4F5F7</Color>
            <Color x:Key="LightCardBg">#FFFFFF</Color>
            <Color x:Key="LightTextPrimary">#1F2937</Color>
            <Color x:Key="LightTextSecondary">#6B7280</Color>

            <!-- Cores para Modo Escuro (Dark Mode) -->
            <Color x:Key="DarkBackground">#121212</Color>
            <Color x:Key="DarkCardBg">#1E1E1E</Color>
            <Color x:Key="DarkTextPrimary">#F9FAFB</Color>
            <Color x:Key="DarkTextSecondary">#9CA3AF</Color>

            <!-- Estilos Globais de Controles -->
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
            </Style>

            <Style TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightCardBg}, Dark={StaticResource DarkCardBg}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#333333}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F9FAFB, Dark=#2A2A2A}" />
                <Setter Property="HeightRequest" Value="44" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F9FAFB, Dark=#2A2A2A}" />
                <Setter Property="HeightRequest" Value="44" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="46" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>